<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_50"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/emerald_700"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Barakah Notif Listener"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Auto-Verify QRIS &amp; Bank Transfer Realtime 24/7"
                    android:textColor="@color/emerald_100"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Live Status Indicator Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/emerald_50"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🟢 "
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tvLiveStatusHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LISTENER AKTIF 24/7 (LOW POWER)"
                        android:textColor="@color/emerald_800"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvLiveStatusDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Aplikasi berjalan di latar belakang tanpa menguras baterai HP. Notifikasi m-Banking akan langsung diverifikasi otomatis!"
                    android:textSize="11sp"
                    android:textColor="@color/emerald_700"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Permission & Service Status Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/white"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Status Izin Akses Notifikasi"
                    android:textColor="@color/gray_800"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPermissionStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Checking..."
                    android:textSize="12sp"
                    android:textColor="@color/gray_700"
                    android:layout_marginTop="4dp" />

                <Button
                    android:id="@+id/btnGrantPermission"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1. Buka Izin Notifikasi Akses"
                    android:backgroundTint="@color/emerald_600"
                    android:textColor="@color/white"
                    android:layout_marginTop="8dp" />

                <Button
                    android:id="@+id/btnOpenAppInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="2. Info Aplikasi (Khusus Android 13/14/15)"
                    android:backgroundTint="@color/gray_700"
                    android:textColor="@color/white"
                    android:layout_marginTop="4dp" />

                <Button
                    android:id="@+id/btnDisableBatteryOpt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⚡ Matikan Hemat Baterai HP (Biar Jalan Terus)"
                    android:backgroundTint="@color/emerald_800"
                    android:textColor="@color/white"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💡 Jika izin dibatasi di Android 13/14/15:\nKlik 'Info Aplikasi' di atas → Klik titik 3 di kanan atas → Pilih 'Izinkan Pengaturan Dibatasi'."
                    android:textSize="10sp"
                    android:textColor="@color/gray_700"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Dynamic Installed App Picker Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/white"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aplikasi Target (Filter Uang Masuk)"
                    android:textColor="@color/gray_800"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSelectedAppsSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Aplikasi Aktif: BSI Mobile, BCA Mobile, DANA, GoPay, OVO, ShopeePay (9 Aplikasi)"
                    android:textSize="11sp"
                    android:textColor="@color/emerald_700"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnPickInstalledApps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🔍 Pilih Aplikasi Terinstall di HP Ini"
                    android:backgroundTint="@color/emerald_600"
                    android:textColor="@color/white" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Settings Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/white"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pengaturan Webhook Server"
                    android:textColor="@color/gray_800"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etWebhookUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Webhook URL Server"
                    android:textSize="12sp"
                    android:inputType="textUri"
                    android:layout_marginTop="8dp" />

                <EditText
                    android:id="@+id/etSecretToken"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Secret Token (X-Android-Secret)"
                    android:textSize="12sp"
                    android:inputType="text"
                    android:layout_marginTop="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <Button
                        android:id="@+id/btnSaveSettings"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Simpan Pengaturan"
                        android:backgroundTint="@color/emerald_600"
                        android:textColor="@color/white"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btnTestWebhook"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tes Webhook"
                        android:backgroundTint="@color/gray_700"
                        android:textColor="@color/white"
                        android:layout_marginStart="4dp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Log Activity Card Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Riwayat Log Notifikasi"
                android:textColor="@color/gray_800"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCopyLog"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📋 Salin Log"
                android:textColor="@color/emerald_700"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnClearLog"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🗑️ Hapus"
                android:textColor="@color/gray_700"
                android:textSize="11sp" />
        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="220dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/white">

            <ScrollView
                android:id="@+id/svLogConsole"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvLogConsole"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="[System Log Output Initialized...]\nAplikasi siap mendeteksi notifikasi transfer bank terpilih.\n"
                    android:fontFamily="monospace"
                    android:textSize="11sp"
                    android:textColor="@color/gray_800"
                    android:textIsSelectable="true" />
            </ScrollView>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>
